<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <style>
        :root {
  --accent: #f7a600;
  --accent-dark: #c77900;
  --text: #111111;
  --text-nav: #fff;
  --muted: #707070;
  --white: #ffffff;

  --site-x: clamp(1.25rem, 5vw, 5rem);
  --header-height: 88px;
  --orbit-size: clamp(480px, 90vh, 740px);
  --main-size: clamp(190px, 80vh, 330px);
  --thumb-size: 120px;
  --active-angle: 0deg;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  background: var(--white);
  font-family: "Roboto", sans-serif;
  overflow-x: hidden;
  scrollbar-width: thin;
  scrollbar-color: var(--accent) #f1f1f1;
}

img {
  display: block;
  max-width: 100%;
}

button,
a,
label {
  cursor: pointer;
}

.site-header {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 50;
  min-height: var(--header-height);
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: clamp(1rem, 4vw, 4rem);
  padding: 1rem var(--site-x);
}

.logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}

.nav-links {
  justify-self: center;
}

.nav-list,
.social {
  display: flex;
  align-items: center;
  gap: clamp(1.25rem, 4vw, 4.5rem);
  padding: 0;
  margin: 0;
  list-style: none;
}

.nav-list a {
  color: #f7a600;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  transition: 0.2s ease;
}

.nav-list a:hover,
.nav-list a:focus-visible {
  color: var(--text-nav);
  outline: none;
}

.cart-button {
  position: relative;
  justify-self: end;
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 0;
  border-radius: 10px;
  background: #d6dde5;
  transition: 0.2s ease;
}

.cart-button-value {
  position: absolute;
  right: -5px;
  top: -5px;
  background-color: #f7a600;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 20px;
  width: 20px;
  height: 20px;
}

.cart-button:hover,
.cart-button:focus-visible {
  background: rgb(255 255 255 / 0.75);
}

/* Slider shell */

.food-slider {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: radial-gradient(
    circle at 70% 60%,
    #89a4cb 0%,
    #2f68b5 30%,
    #2f68b5 60%,
    rgb(8 83 162) 100%
  );
}

.food-slider::before {
  content: "";
  position: absolute;
  right: -10%;
  inset: 0;
  background: var(--white);
  mask: radial-gradient(circle at 70% -35%, transparent 0 49.92%, #000 50%);
  z-index: 5;
}

.slider-state {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
}

.food-slider__inner {
  display: grid;
  grid-template-columns: minmax(260px, 0.82fr) minmax(480px, 1.4fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 5rem);
  min-height: 100vh;
  padding: calc(var(--header-height) + 1rem) var(--site-x) 5rem;
}

/* Text */

.dish-content {
  position: relative;
  z-index: 7;
  min-height: 390px;
}

.dish-panel {
  position: absolute;
  inset: 0 auto auto 0;
  width: min(100%, 430px);
  opacity: 0;
  visibility: hidden;
  transform: translateX(-24px);
  pointer-events: none;
  transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.4s ease;
}

.dish-price {
  margin: 0 0 1rem;
  color: var(--accent);
  font-size: clamp(2.1rem, 4vw, 3.1rem);
  font-weight: 850;
  line-height: 1;
  letter-spacing: 0.12em;
}

.dish-panel h2 {
  margin: 0 0 1.25rem;
  font-size: clamp(2.15rem, 4vw, 3.35rem);
  line-height: 1.08;
  font-family: "Courgette", cursive;
  letter-spacing: 0.01em;
}

.dish-panel p:not(.dish-price) {
  max-width: 36ch;
  margin: 0 0 2rem;
  color: var(--muted);
  line-height: 1.55;
}

.dish-panel button {
  position: relative;
  min-width: 190px;
  min-height: 56px;
  border: 0;
  border-radius: 999px;
  padding: 0.85rem 1.4rem;
  color: var(--white);
  background: var(--accent);
  font-size: 18px;
  font-family: serif;
  font-weight: 700;
  box-shadow: 0 18px 36px rgb(247 166 0 / 0.3);
  transition: all 0.2s ease;
}

.dish-panel button:before {
  content: url("https://raw.githubusercontent.com/BlackStar1991/Pictures-for-sharing-/master/ukrainian-cuisine/img/cart.svg");
  position: absolute;
  left: 15px;
  top: 10px;
  width: 34px;
  height: 34px;

  object-fit: cover;
}

.dish-panel button:hover,
.dish-panel button:focus-visible {
  background: var(--accent-dark);
  outline: none;
  transform: translateY(-2px);
  box-shadow: 0 20px 40px rgb(247 166 0 / 0.4);
}

/* Scene */

.dish-scene {
  position: relative;
  min-height: min(680px, 76vh);
}

.dish-main {
  position: absolute;

  left: 50%;
  top: 58%;
  width: var(--main-size);
  height: var(--main-size);
  transform: translate3d(-50%, -50%, 0);
  border-radius: 50%;
  filter: drop-shadow(0 28px 30px rgb(0 0 0 / 0.3));
  z-index: 6;
  border: 0;
  background: transparent;
}

.main-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0;
  transform: scale(0.92) rotate(-4deg);
  transition: opacity 0.35s ease, transform 0.45s ease;
}
/* Dish image popover buttons for all recipes */
.dish-scene .dish-main {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.35s ease, visibility 0.35s ease, filter 0.2s ease;
}

.dish-scene .dish-main:hover,
.dish-scene .dish-main:focus-visible {
  filter: drop-shadow(0 32px 34px rgb(0 0 0 / 0.36));
}

.dish-main .main-image {
  opacity: 1;
  transform: scale(1) rotate(0deg);
}

#dish-1:checked ~ .food-slider__inner .dish-main-1,
#dish-2:checked ~ .food-slider__inner .dish-main-2,
#dish-3:checked ~ .food-slider__inner .dish-main-3,
#dish-4:checked ~ .food-slider__inner .dish-main-4,
#dish-5:checked ~ .food-slider__inner .dish-main-5,
#dish-6:checked ~ .food-slider__inner .dish-main-6,
#dish-7:checked ~ .food-slider__inner .dish-main-7,
#dish-8:checked ~ .food-slider__inner .dish-main-8,
#dish-9:checked ~ .food-slider__inner .dish-main-9,
#dish-10:checked ~ .food-slider__inner .dish-main-10,
#dish-11:checked ~ .food-slider__inner .dish-main-11,
#dish-12:checked ~ .food-slider__inner .dish-main-12 {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.popup[popover] {
  z-index: 100;
}

.recipe-card__media {
  display: flex;
  justify-content: center;
}

/* Orbit */

.dish-orbit {
  position: absolute;
  left: 50%;
  top: 58%;
  width: var(--orbit-size);
  height: var(--orbit-size);
  border-radius: 50%;
  transform: translate3d(-50%, -50%, 0) rotate(var(--active-angle));
  transition: transform 0.75s cubic-bezier(0.22, 0.8, 0.22, 1);
  will-change: transform;
  backface-visibility: hidden;
  transform-style: preserve-3d;
  border: 2px dashed #cf901f;
  z-index: 3;
}

.orbit-item {
  --angle: calc(var(--i) * 30deg);
  position: absolute;
  left: 50%;
  top: 50%;
  display: grid;
  place-items: center;
  width: var(--thumb-size);
  height: var(--thumb-size);
  margin: calc(var(--thumb-size) / -2);
  transform: rotate(var(--angle)) translateY(calc(var(--orbit-size) / -2))
    rotate(calc(-1 * var(--angle)));
  backface-visibility: hidden;
}

.orbit-thumb {
  display: block;
  width: 100%;
  height: 100%;
  transform: rotate(calc(-1 * var(--active-angle)));
  transition: transform 0.75s cubic-bezier(0.22, 0.8, 0.22, 1);
  will-change: transform;
  backface-visibility: hidden;
}

.orbit-thumb img {
  width: 124%;
  height: 124%;
  margin: -12%;
  object-fit: contain;
  transform: translateZ(0);
  backface-visibility: hidden;
  pointer-events: none;
}

/* Checked states */

#dish-1:checked ~ .food-slider__inner {
  --active-angle: 0deg;
}

#dish-2:checked ~ .food-slider__inner {
  --active-angle: -30deg;
}

#dish-3:checked ~ .food-slider__inner {
  --active-angle: -60deg;
}

#dish-4:checked ~ .food-slider__inner {
  --active-angle: -90deg;
}

#dish-5:checked ~ .food-slider__inner {
  --active-angle: -120deg;
}

#dish-6:checked ~ .food-slider__inner {
  --active-angle: -150deg;
}

#dish-7:checked ~ .food-slider__inner {
  --active-angle: -180deg;
}

#dish-8:checked ~ .food-slider__inner {
  --active-angle: -210deg;
}

#dish-9:checked ~ .food-slider__inner {
  --active-angle: -240deg;
}

#dish-10:checked ~ .food-slider__inner {
  --active-angle: -270deg;
}

#dish-11:checked ~ .food-slider__inner {
  --active-angle: -300deg;
}

#dish-12:checked ~ .food-slider__inner {
  --active-angle: -330deg;
}

#dish-1:checked ~ .food-slider__inner .dish-panel-1,
#dish-2:checked ~ .food-slider__inner .dish-panel-2,
#dish-3:checked ~ .food-slider__inner .dish-panel-3,
#dish-4:checked ~ .food-slider__inner .dish-panel-4,
#dish-5:checked ~ .food-slider__inner .dish-panel-5,
#dish-6:checked ~ .food-slider__inner .dish-panel-6,
#dish-7:checked ~ .food-slider__inner .dish-panel-7,
#dish-8:checked ~ .food-slider__inner .dish-panel-8,
#dish-9:checked ~ .food-slider__inner .dish-panel-9,
#dish-10:checked ~ .food-slider__inner .dish-panel-10,
#dish-11:checked ~ .food-slider__inner .dish-panel-11,
#dish-12:checked ~ .food-slider__inner .dish-panel-12 {
  opacity: 1;
  visibility: visible;
  transform: translateX(0);
  pointer-events: auto;
}

#dish-1:checked ~ .food-slider__inner .main-image-1,
#dish-2:checked ~ .food-slider__inner .main-image-2,
#dish-3:checked ~ .food-slider__inner .main-image-3,
#dish-4:checked ~ .food-slider__inner .main-image-4,
#dish-5:checked ~ .food-slider__inner .main-image-5,
#dish-6:checked ~ .food-slider__inner .main-image-6,
#dish-7:checked ~ .food-slider__inner .main-image-7,
#dish-8:checked ~ .food-slider__inner .main-image-8,
#dish-9:checked ~ .food-slider__inner .main-image-9,
#dish-10:checked ~ .food-slider__inner .main-image-10,
#dish-11:checked ~ .food-slider__inner .main-image-11,
#dish-12:checked ~ .food-slider__inner .main-image-12 {
  opacity: 1;
  transform: scale(1) rotate(0deg);
}

/* Navigation */

.slider-nav {
  position: absolute;
  z-index: 10;
  left: 50%;
  bottom: 13%;
  width: min(520px, 70%);
  transform: translateX(-50%);
  pointer-events: none;
}

.nav-arrow {
  position: absolute;
  top: 0;
  display: none;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: var(--white);
  pointer-events: auto;
  box-shadow: 0 10px 12px rgb(0 0 0 / 0.8);
  transition: 0.2s ease;
}

.nav-arrow::before {
  content: url("https://raw.githubusercontent.com/BlackStar1991/Pictures-for-sharing-/master/ukrainian-cuisine/img/arrow.svg");
  object-fit: contain;
  position: absolute;
  left: 50%;
  top: 47%;
  width: 30px;
  height: 30px;
  transform: translate(-50%, -50%);
}

.nav-arrow:hover,
.nav-arrow:focus-visible {
  transform: translateY(-2px);
  outline: 2px solid rgb(247 166 0 / 0.3);
}

.nav-prev {
  left: 0;
}

.nav-next {
  right: 0;
}

#dish-1:checked ~ .food-slider__inner .nav-from-1,
#dish-2:checked ~ .food-slider__inner .nav-from-2,
#dish-3:checked ~ .food-slider__inner .nav-from-3,
#dish-4:checked ~ .food-slider__inner .nav-from-4,
#dish-5:checked ~ .food-slider__inner .nav-from-5,
#dish-6:checked ~ .food-slider__inner .nav-from-6,
#dish-7:checked ~ .food-slider__inner .nav-from-7,
#dish-8:checked ~ .food-slider__inner .nav-from-8,
#dish-9:checked ~ .food-slider__inner .nav-from-9,
#dish-10:checked ~ .food-slider__inner .nav-from-10,
#dish-11:checked ~ .food-slider__inner .nav-from-11,
#dish-12:checked ~ .food-slider__inner .nav-from-12 {
  display: block;
}

.decor-element {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 5;
  width: 15vw;
  opacity: 0.3;
}

/* Footer */

.site-footer {
  position: fixed;
  z-index: 45;
  right: var(--site-x);
  bottom: 2rem;
}

.social {
  gap: 1.5rem;
}

.social a {
  display: grid;
  place-items: center;
  min-width: 26px;
  min-height: 26px;
  font-weight: 850;
  text-transform: uppercase;
}

/* Main dish popover trigger */

.dish-main {
  border: 0;
  padding: 0;
  background: transparent;
  cursor: pointer;
}

.dish-main:focus-visible {
  outline: 3px solid rgb(247 166 0 / 0.55);
  outline-offset: 12px;
}

.main-image {
  pointer-events: none;
}

/* Recipe popup */

.popup[popover] {
  position: fixed;
  inset: 0;
  width: min(600px, calc(100vw - 2rem));
  max-height: min(680px, calc(100dvh - 2rem));
  margin: auto;
  padding: 0;

  border: 8px solid #e9e9e7;
  border-radius: 28px;

  background: #f9f1e5;
  overflow: hidden;

  &:after {
    content: "";
    position: absolute;
    top: -12px;
    left: 0;
    width: 100%;
    height: 30px;
    background: url("https://raw.githubusercontent.com/BlackStar1991/Pictures-for-sharing-/master/ukrainian-cuisine/img/pattern.svg")
      50% 50% repeat;
    background-size: contain;
  }

  &:before {
    content: "";
    position: absolute;
    bottom: -12px;
    left: 0;
    width: 100%;
    height: 30px;
    background: url("https://raw.githubusercontent.com/BlackStar1991/Pictures-for-sharing-/master/ukrainian-cuisine/img/pattern.svg")
      50% 50% repeat;
    background-size: contain;
  }
}

.popup[popover]::backdrop {
  background: rgb(8 26 48 / 0.62);
  backdrop-filter: blur(4px);
}

.btn-close {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 50%;
  background: var(--white);
  color: var(--text);
  font-size: 1.65rem;
  line-height: 1;
  box-shadow: 0 12px 26px rgb(0 0 0 / 0.14);
  transition: 0.2s ease;
}

.btn-close:hover,
.btn-close:focus-visible {
  color: var(--white);
  background: var(--accent);
  outline: none;
  transform: translateY(-1px);
}

.recipe-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: clamp(1.35rem, 3vw, 2.2rem);
  max-height: min(760px, calc(100dvh - 2rem));
  overflow: auto;
  margin-right: 12px;
  padding-right: 12px;
  padding-bottom: 84px;

  scrollbar-width: thin;
  scrollbar-color: var(--accent) #f1f1f1;

  &::-webkit-scrollbar {
    width: 8px;
    height: 8px;
    background-color: #f1f1f1;
  }

  &::-webkit-scrollbar-thumb {
    background-color: var(--accent);
    border-radius: 6px;
    border: 3px solid #f1f1f1;
  }

  &::-webkit-scrollbar-thumb:hover {
    background-color: var(--accent-dark);
  }
}

.recipe-card__hero {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(180px, 0.86fr) minmax(260px, 1.14fr);
  gap: clamp(1.25rem, 3vw, 2.5rem);
  align-items: center;
  padding-bottom: clamp(1.25rem, 3vw, 2rem);
  border-bottom: 1px solid rgb(207 144 31 / 0.22);
}

.recipe-card__img {
  max-width: 220px;
  object-fit: contain;
  filter: drop-shadow(0 22px 28px rgb(0 0 0 / 0.2));
}

.recipe-card__eyebrow {
  text-align: center;
  margin: 0 0 0.65rem;
  color: var(--accent-dark);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 1px;
}

.recipe-card__title {
  position: relative;
  margin: 0 0 30px;
  color: var(--text);
  font-family: "Courgette", cursive;
  font-size: 29px;
  text-align: center;
  line-height: 1.05;
  padding-bottom: 20px;
  white-space: nowrap;

  &:before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 1px;
    border-bottom: 1px solid #9d784e;
  }

  &:after {
    content: url("https://raw.githubusercontent.com/BlackStar1991/Pictures-for-sharing-/master/ukrainian-cuisine/img/decor-big.svg");
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    object-fit: contain;
    width: 140px;
    height: 40px;
  }
}

.recipe-card__text {
  max-width: 38ch;
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
}

.recipe-card__content {
  border-top: 1px solid #9d784e;
  padding: 20px 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(1.25rem, 4vw, 3rem);
}

.recipe-card__subtitle {
  width: fit-content;
  position: relative;
  margin: 0 auto 1rem;
  color: var(--text);
  font-family: "Courgette", cursive;
  font-size: clamp(1.35rem, 3vw, 2rem);
  line-height: 1.2;
}

.recipe-card__subtitle::before,
.recipe-card__subtitle::after {
  position: absolute;
  top: 50%;
  width: 20px;
  height: 20px;
  content: "";
  background-image: url("https://raw.githubusercontent.com/BlackStar1991/Pictures-for-sharing-/master/ukrainian-cuisine/img/decor-elem.svg");
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;
  transform: translateY(-50%);
}

.recipe-card__subtitle::before {
  left: -30px;
}

.recipe-card__subtitle::after {
  right: -30px;
}

.recipe-card__section {
  position: relative;
  height: 224px;
  overflow-y: auto;

  &::-webkit-scrollbar {
    width: 8px;
    height: 8px;
    background-color: #f1f1f1;
  }

  &::-webkit-scrollbar-thumb {
    background-color: var(--accent);
    border-radius: 6px;
    border: 3px solid #f1f1f1;
  }

  &::-webkit-scrollbar-thumb:hover {
    background-color: var(--accent-dark);
  }
}

.recipe-card__left {
  direction: rtl;
}

.recipe-card__right {
  direction: ltr;
}

.recipe-list {
  margin: 0;
  padding: 0;
  color: #3f3f3f;
  line-height: 1.75;
}

.recipe-list--bullets {
  list-style: none;
  padding-left: 30px;
}

.recipe-list--bullets li {
  position: relative;
  padding-left: 15px;
}

.recipe-list--bullets li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #bd7c10;
}

.recipe-list--steps {
  list-style: none;
  counter-reset: recipe-step;
}

.recipe-list--steps li {
  position: relative;
  min-height: 2rem;
  padding-left: 2.5rem;
  counter-increment: recipe-step;
}

.recipe-list--steps li::before {
  content: counter(recipe-step);
  position: absolute;
  left: 0;
  top: 0.18rem;
  display: grid;
  place-items: center;
  width: 1.65rem;
  height: 1.65rem;
  border-radius: 50%;
  color: #000;
  background: #efe0ca;
  font-size: 0.85rem;
  font-weight: 700;
}

.recipe-card__button {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: inline-flex;
  margin: 10px auto 0;
  align-items: center;
  justify-content: center;
  min-width: 180px;
  min-height: 54px;
  border-radius: 50px;
  padding: 0.85rem 1.6rem;
  color: var(--white);
  background: var(--accent);
  font: inherit;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 18px 36px rgb(247 166 0 / 0.28);
  transition: 0.2s ease;

  &:before {
    content: url("https://raw.githubusercontent.com/BlackStar1991/Pictures-for-sharing-/master/ukrainian-cuisine/img/recipe-button.svg");
    width: 24px;
    height: 24px;
